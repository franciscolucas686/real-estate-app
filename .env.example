# Copy to .env.development and adjust for local development.
# .env.development is gitignored — never commit it.

# Backend base URL used by the Vite dev-server proxy (server.proxy['/api'] in
# vite.config.ts). Só vale localmente: em produção não há proxy nenhum — o cliente
# chama a API direto via VITE_API_BASE_URL abaixo.
#
# OPCIONAL: sem ela o vite.config.ts já cai neste mesmo endereço, que é onde a
# api-real-estate roda. Só preencha para apontar o dev-server para outro back-end.
VITE_API_URL=http://localhost:3000

# Raiz da API (SEM sufixo /api — o backend não tem prefixo global) para o cliente
# chamar direto, sem passar por proxy nenhum. Em produção vale
# https://api.francinegestoraimobiliaria.com (ver .env.production).
#
# Deixe VAZIO em desenvolvimento: assim o cliente usa o caminho relativo /api e o
# proxy do Vite acima cuida do encaminhamento (removendo o /api), o que mantém tudo
# na mesma origem e dispensa CORS localmente.
#
# Note que é diferente de VITE_API_URL acima, que é o host raiz usado como alvo do
# proxy.
VITE_API_BASE_URL=

# Liga o redimensionamento de imagem na borda (/cdn-cgi/image/...). Deixe VAZIO em
# desenvolvimento: as fotos vêm do MinIO em localhost:9000, que não conhece esse
# caminho, e toda imagem quebraria.
#
# Só defina como "true" depois que o bucket R2 estiver atrás de um domínio na
# Cloudflare com transformações de imagem habilitadas.
VITE_IMAGE_CDN=

# VITE_ADMIN_SECRET foi removida e não deve voltar. O header x-admin-secret que
# whatsapp-service.ts mandava era ignorado pelo backend (/whatsapp-numbers usa só
# JwtGuard; o AdminSecretGuard existe apenas em POST /auth/register), e toda
# variável VITE_* é embutida no bundle público — defini-la publicaria o
# ADMIN_SECRET do backend. Se alguma rota passar a exigi-lo, a chamada tem que
# sair do navegador, não ganhar a variável de volta.
