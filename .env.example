# Copy to .env.development and adjust for local development.
# .env.development is gitignored — never commit it.

# Backend base URL used by the Vite dev-server proxy (server.proxy['/api'] in
# vite.config.ts). In production this role is played by vercel.json's rewrite
# instead (Vercel doesn't run Vite's dev server), so this only matters locally.
VITE_API_URL=http://localhost:3000

# Admin secret header (x-admin-secret) for admin-only endpoints
# (POST /auth/register, POST /whatsapp-numbers). Must match the backend's
# ADMIN_SECRET. Inlined into the client bundle at build time — never a real
# secret in production, only useful for local/dev convenience.
VITE_ADMIN_SECRET=
