# Copy to .env.development and adjust for local development.
# .env.development is gitignored — never commit it.

# Backend base URL used by the Vite dev-server proxy (server.proxy['/api'] in
# vite.config.ts). In production this role is played by vercel.json's rewrite
# instead (Vercel doesn't run Vite's dev server), so this only matters locally.
VITE_API_URL=http://localhost:3000

# URL completa da API (INCLUINDO o sufixo /api) para o cliente chamar direto,
# sem passar por proxy nenhum. Deixe VAZIO em desenvolvimento: assim o cliente usa
# o caminho relativo /api e o proxy do Vite acima cuida do encaminhamento, o que
# mantém tudo na mesma origem.
#
# Só passa a ser preenchida quando app e API viverem em subdomínios do mesmo
# domínio — ex.: https://api.seudominio.com/api — momento em que o rewrite do
# vercel.json pode ser removido. Note que é diferente de VITE_API_URL acima, que é
# o host raiz usado como alvo do proxy.
VITE_API_BASE_URL=

# Liga o redimensionamento de imagem na borda (/cdn-cgi/image/...). Deixe VAZIO em
# desenvolvimento: as fotos vêm do MinIO em localhost:9000, que não conhece esse
# caminho, e toda imagem quebraria.
#
# Só defina como "true" depois que o bucket R2 estiver atrás de um domínio na
# Cloudflare com transformações de imagem habilitadas.
VITE_IMAGE_CDN=

# Admin secret header (x-admin-secret) for admin-only endpoints
# (POST /auth/register, POST /whatsapp-numbers). Must match the backend's
# ADMIN_SECRET. Inlined into the client bundle at build time — never a real
# secret in production, only useful for local/dev convenience.
VITE_ADMIN_SECRET=
