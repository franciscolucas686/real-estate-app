# Production defaults — safe to commit, contains no secrets.
# Vercel dashboard env vars (if set) take precedence over this file at build time.

# Sem efeito no build de produção: só alimenta o proxy do dev-server, que o
# `vite build` nunca inicia. Mantida vazia para deixar isso explícito.
VITE_API_URL=

# Vazia enquanto o rewrite do vercel.json estiver encaminhando /api — o cliente
# usa o caminho relativo e tudo fica na mesma origem.
#
# Ao migrar para domínio próprio, preencher com https://api.seudominio.com/api
# (preferencialmente pelo painel da Vercel) e remover o rewrite do vercel.json.
# Os dois passos andam juntos: preencher sem remover o rewrite só deixa uma rota
# morta; remover sem preencher quebra todas as chamadas de API.
VITE_API_BASE_URL=

# "true" só depois que o bucket R2 estiver atrás de um domínio na Cloudflare com
# transformações habilitadas. Ligar antes disso quebra todas as fotos do site.
VITE_IMAGE_CDN=